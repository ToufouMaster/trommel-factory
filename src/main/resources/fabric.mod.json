{
  "schemaVersion": 1,
  "id": "trommelfactory",
  "version": "${version}",

  "name": "Trommel Factory",
  "description": "Adds new ressources to cruch and automate ore production.",
  "authors": [
    "ToufouMaster"
  ],
  "contact": {
    "homepage": "",
    "sources": ""
  },

	"icon": "icon.png",
  "license": "CC0-1.0",

  "environment": "*",
  "entrypoints": {
    "main": [
			"toufoumaster.trommelfactory.TrommelFactory"
